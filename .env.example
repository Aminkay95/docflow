# Process environment. Copy to .env and replace every secret.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://trade:trade@localhost:5432/trade_extract
TEST_DATABASE_URL=postgresql+psycopg://trade:trade@localhost:5432/trade_extract_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-development-secret-key
# SECRET_KEY also signs internal /review sessions. Production cookies require HTTPS.
# Provision reviewers with: uv run python scripts/provision_reviewer.py USERNAME
API_KEY_PEPPER=change-me-development-api-key-pepper

# Storage
STORAGE_BACKEND=filesystem
STORAGE_DIR=./var/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public base for status_url / result_url
BASE_URL=http://localhost:8000

# Limits
MAX_DOCUMENTS_PER_GROUP=20
MAX_FILE_BYTES=26214400
MAX_PAGES_PER_FILE=500
MAX_PAGES_PER_SUBMISSION=2000
# Whole-request cap; defaults to 20 x MAX_FILE_BYTES plus multipart overhead.
# MAX_REQUEST_BYTES=532676608
RETRY_AFTER_SECONDS=2

# Page rendering and always-on segmentation
PAGE_RENDER_DPI=300
# Thumbnail long edge in pixels; thumbnails are not a second full-size raster.
PAGE_THUMBNAIL_MAX_PX=512
PAGE_IMAGE_QUALITY=85
# Floor for two gates: the top type's share of the top-two score and the raw
# weighted top score. A tie is always `unknown`.
SEGMENTATION_MIN_CONFIDENCE=0.55

# Task and webhook recovery
TASK_STALE_AFTER_SECONDS=900
TASK_MAX_REQUEUES=3
TASK_BACKOFF_BASE_SECONDS=2
TASK_BACKOFF_MAX_SECONDS=300
WEBHOOK_STALE_AFTER_SECONDS=900

# Webhooks
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_CONNECT_TIMEOUT_SECONDS=5
# Never enable outside a local test harness: it disables the SSRF guard.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Worker
WORKER_POLL_SECONDS=1.0
WORKER_ID=
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10

# Explicit opt-in is required for live inference.
PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_MAX_REPAIRS=2
PROVIDER_MAX_OUTPUT_TOKENS=8192
PROVIDER_MAX_IMAGES=20
PROVIDER_MAX_IMAGE_BYTES=20000000
PROVIDER_BACKOFF_MAX_SECONDS=30

# Provisional image-quality-v1 policy; no OCR confidence or model scoring.
CONDITIONING_MAX_PIXELS=40000000
CONDITIONING_ANALYSIS_MAX_PX=1600
CONDITIONING_MIN_SHORT_EDGE=600
CONDITIONING_MIN_CONTRAST=25
CONDITIONING_MIN_BLUR=15
CONDITIONING_MIN_INK=0.001
CONDITIONING_MAX_INK=0.8
CONDITIONING_MAX_SKEW=12
CONDITIONING_MAX_ENLARGEMENT=1

# Provisional routing; positive page features are supplied by the caller of extraction.
ROUTING_VERSION=reader-routing-v1-provisional
ROUTING_MIN_TEXT_CHARACTERS=40
ROUTING_DENSE_ROW_THRESHOLD=20
OCR_MAX_PIXELS=40000000
OCR_MAX_SPANS=10000
OCR_MAX_REGIONS=100
OCR_MAX_ROWS=2000
OCR_MAX_CELLS=20000
OCR_MAX_HTML_BYTES=1000000
TABLE_MAX_CROPS=2000
TABLE_MAX_CROP_PIXELS=8000000
TABLE_MAX_TOTAL_CROP_PIXELS=80000000
TABLE_MAX_BATCHES=200
