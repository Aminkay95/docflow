FROM python:3.12-slim

USER 0

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300 \
    UV_PROJECT_ENVIRONMENT=/opt/doc-hover-worker-venv

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN install -d "$UV_PROJECT_ENVIRONMENT" \
    && uv sync --frozen --no-dev --no-install-project --extra conditioning --extra ocr --extra s3

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./
RUN uv sync --frozen --no-dev --no-editable --extra conditioning --extra ocr --extra s3

ENV PATH="/opt/doc-hover-worker-venv/bin:$PATH"

RUN if ! id appuser >/dev/null 2>&1; then useradd --create-home --uid 10001 appuser; fi \
    && test "$(id -u appuser)" = 10001 \
    && mkdir -p /app/var/storage /home/appuser/.paddlex /home/appuser/.paddleocr \
    && chown -R appuser:appuser /app/var /home/appuser
USER appuser

CMD ["python", "-m", "trade_extract.workers"]
